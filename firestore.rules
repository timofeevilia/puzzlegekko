rules_version = '2';
// Copy into Firebase console → Firestore Database → Rules, then Publish.
// Every game gets its own top-level collection. Anything not listed here is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Golden Land: golden-land/<ROOM>/game/{current,lobby,answer} and golden-land/<ROOM>/live/{react,presence}.
    // Anyone signed in (anonymous auth) who knows the room code can play in that room.
    match /golden-land/{room}/{section}/{doc} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && room.size() >= 4 && room.size() <= 8
                            && section in ['game', 'live']
                            && request.resource.data.size() < 200;
      allow delete: if signedIn();
    }

    // Tolmach: tolmach/<ROOM>/game/{state,lobby}.
    match /tolmach/{room}/{section}/{doc} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && room.size() >= 4 && room.size() <= 8
                            && section == 'game'
                            && request.resource.data.size() < 100;
      allow delete: if signedIn();
    }

    // Sabai Thai: progress opened with a study code, sabai-thai/<CODE>/data/progress.
    match /sabai-thai/{code}/{section}/{doc} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && code.size() == 8
                            && section == 'data'
                            && request.resource.data.size() < 60;
      allow delete: if signedIn();
    }

    // Sabai Thai: progress of a Google account, readable and writable only by that account.
    match /sabai-thai-users/{uid}/{section}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gekko Party: party/<ROOM>/game/state is written only by the host screen that created it;
    // party/<ROOM>/players/<uid> and party/<ROOM>/input/<uid>[_suffix] only by that player.
    match /party/{room}/{section}/{doc} {
      function mine() { return doc == request.auth.uid || doc.matches(request.auth.uid + '_[a-z0-9]+'); }
      allow read: if signedIn();
      allow create: if signedIn() && room.size() >= 4 && room.size() <= 8
                    && (section == 'game' ? request.resource.data.host == request.auth.uid
                                          : section in ['players', 'input'] && mine());
      allow update: if signedIn()
                    && (section == 'game' ? resource.data.host == request.auth.uid && request.resource.data.host == request.auth.uid
                                          : section in ['players', 'input'] && mine());
      allow delete: if signedIn() && (section == 'game' ? resource.data.host == request.auth.uid : mine());
    }

    // Next online game: add a block like the one above with its own collection name.
  }
}
